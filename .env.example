# Django settings
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True

# Database
# For SQLite (default), no additional configuration needed
# For PostgreSQL, uncomment and configure:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lore_search_engine_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=database
DB_PORT=5432

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEXES=^https?://.*\.replit\.dev$
CSRF_TRUSTED_ORIGINS=https://*.replit.dev,https://*.replit.dev:8000,http://*.replit.dev,http://*.replit.dev:8000
